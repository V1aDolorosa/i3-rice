configuration {
    modi: "drun,run,window";
    show-icons: true;

    display-drun: "Apps";
    display-run: "Run";
    display-window: "Windows";

    drun-display-format: "{name}";
    font: "JetBrainsMono Nerd Font 11";
    terminal: "ghostty";

    icon-theme: "oomox-Kanagawa";

    hover-select: false;
    matching: "fuzzy";
    sort: true;
}

* {
    bg: #16161D;
    bg-alt: #1F1F28;
    fg: #DCD7BA;
    muted: #727169;
    accent: #7E9CD8;
    selected-bg: #7E9CD8;
    selected-fg: #1F1F28;

    background-color: transparent;
    text-color: @fg;
    border-color: @accent;
}
window {
    width: 620px;
    border: 2px;
    border-radius: 12px;
    border-color: @accent;
    background-color: @bg;
    padding: 18px;
}

mainbox {
    background-color: transparent;
    children: [inputbar, listview];
    spacing: 14px;
}

inputbar {
    background-color: @bg-alt;
    border: 1px;
    border-radius: 8px;
    border-color: @accent;
    padding: 10px 14px;
    children: [prompt, entry];
    spacing: 10px;
}

prompt {
    text-color: @accent;
}

entry {
    placeholder: "Search applications...";
    placeholder-color: @muted;
    text-color: @fg;
}

listview {
    columns: 1;
    lines: 7;
    fixed-height: true;
    cycle: true;
    scrollbar: false;
    spacing: 5px;
    background-color: transparent;
}

element {
    padding: 8px;
    border-radius: 7px;
    background-color: transparent;
}

element normal {
    text-color: @fg;
}

element selected.normal {
    background-color: @selected-bg;
    text-color: @selected-fg;
}

element selected.active {
    background-color: @selected-bg;
    text-color: @selected-fg;
}

element selected.urgent {
    background-color: @selected-bg;
    text-color: @selected-fg;
}

element-icon {
    size: 24px;
    margin: 0 10px 0 0;
    background-color: transparent;
}

element-text {
    vertical-align: 0.5;
    background-color: transparent;
}
