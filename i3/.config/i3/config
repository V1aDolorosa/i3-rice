# =========================================
# КЛАВИАТУРА
# =========================================

# Переключение раскладки: Right Alt и Win + Space
exec_always --no-startup-id setxkbmap -layout us,ru -option "" -option grp:ralt_toggle -option grp:win_space_toggle

# =========================================
# АВТОЗАПУСК
# =========================================

# Композитор
exec --no-startup-id picom

# Панель
exec --no-startup-id polybar

# Домашний экран
exec --no-startup-id ~/.local/bin/start-home

# Обои
exec --no-startup-id feh --bg-fill "$HOME/Загрузки/tokyo-night _wallpaper.png"

# =========================================
# ПЕРЕЗАГРУЗКА И КОНФИГУРАЦИЯ
# =========================================

# Перезагрузка конфига
bindsym $mod+Shift+c reload

# Перезапуск i3
bindsym $mod+Shift+r restart
